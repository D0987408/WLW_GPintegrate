{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A.Literature v2.0",
  "type": "object",
  "required": ["contract", "schema_version", "artifact_id", "producer", "payload"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "A.Literature"},
    "schema_version": {"const": "2.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object",
      "required": ["corpus", "literature_list"],
      "additionalProperties": false,
      "properties": {
        "corpus": {
          "type": "object",
          "required": [
            "corpus_id", "title", "source_file", "source_path", "sha256",
            "source_size_bytes", "literature_count"
          ],
          "additionalProperties": false,
          "properties": {
            "corpus_id": {"type": "string", "minLength": 1},
            "title": {"type": "string", "minLength": 1},
            "source_file": {"type": "string", "minLength": 1},
            "source_path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "minLength": 1},
            "source_size_bytes": {"type": "integer", "minimum": 1},
            "literature_count": {"type": "integer", "minimum": 1}
          }
        },
        "literature_list": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "literature_id", "source_idx", "level", "title_list", "title", "href",
              "sections"
            ],
            "additionalProperties": false,
            "properties": {
              "literature_id": {"type": "string", "minLength": 1},
              "source_idx": {"type": "integer", "minimum": 0},
              "level": {"type": "integer", "minimum": 1, "maximum": 3},
              "title_list": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": ["string", "null"]}
              },
              "title": {"type": "string", "minLength": 1},
              "href": {"type": ["string", "null"]},
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["section_id", "section_idx", "title", "text"],
                  "additionalProperties": false,
                  "properties": {
                    "section_id": {"type": "string", "minLength": 1},
                    "section_idx": {"type": "integer", "minimum": 0},
                    "title": {"type": "string", "minLength": 1},
                    "text": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
