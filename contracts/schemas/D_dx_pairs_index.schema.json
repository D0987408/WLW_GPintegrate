{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D.DxPairsIndex v1.0",
  "type": "object",
  "required": ["contract", "schema_version", "artifact_id", "producer", "payload"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "D.DxPairsIndex"},
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object",
      "required": ["cases"],
      "additionalProperties": false,
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["case_id", "artifact_path"],
            "additionalProperties": false,
            "properties": {
              "case_id": {"type": "string", "minLength": 1},
              "artifact_path": {"type": "string", "minLength": 1}
            }
          }
        },
        "skipped_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "reason"],
            "additionalProperties": false,
            "properties": {
              "case_id": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
